<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Bot bubble uses white background with subtle stroke -->
    <solid android:color="@color/smish_white"/>
    <stroke
        android:width="1dp"
        android:color="@color/smish_stroke"/>

    <corners android:radius="18dp"/>

    <padding
        android:left="14dp"
        android:top="12dp"
        android:right="14dp"
        android:bottom="12dp"/>
</shape>
